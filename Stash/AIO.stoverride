name: "AIO"
rules:
  - "DOMAIN,afd.baidu.com,REJECT"
  - "DOMAIN,mobads.baidu.com,REJECT"
  - "DOMAIN,adservice.sigmob.cn,REJECT"
  - "DOMAIN,ctrace.yg84.com,REJECT"
  - "DOMAIN,mobads-logs.baidu.com,REJECT"
  - "DOMAIN,adx.yg84.com,REJECT"
  - "DOMAIN,atrace.chelaile.net.cn,REJECT"
  - "DOMAIN,qbad.sginput.qq.com,REJECT"
  - "DOMAIN,tangram.e.qq.com,REJECT"
  - "DOMAIN,sdkreport.e.qq.com,REJECT"
  - "DOMAIN-SUFFIX,gdt.qq.com,REJECT"
http:
  force-http-engine:
    - "ecom.map.baidu.com:80"
    - "api.chelaile.net.cn:80"
    - "cdn.api.chelaileapp.cn:80"
    - "swc.pinyin.sogou.com:80"
  mitm:
    - "ecom.map.baidu.com:*"
    - "api.chelaile.net.cn:*"
    - "cdn.api.chelaileapp.cn:*"
    - "get.shouji.sogou.com:*"
    - "sec.sginput.qq.com:*"
    - "worldwide.sogou.com:*"
    - "swc.pinyin.sogou.com:*"
  url-rewrite:
    - "^https?://[eE][cC][oO][mM]\\.[mM][aA][pP]\\.[bB][aA][iI][dD][uU]\\.[cC][oO][mM](?::\\d+)?/ad-ops/afd/entry(?:\\?[^#]*)?$ - reject"
    - "^https?://[eE][cC][oO][mM]\\.[mM][aA][pP]\\.[bB][aA][iI][dD][uU]\\.[cC][oO][mM](?::\\d+)?/ad-ops/afd/material_async(?:\\?[^#]*)?$ - reject"
    - "(?i)^https?://(?:api\\.chelaile\\.net\\.cn|cdn\\.api\\.chelaileapp\\.cn)(?::\\d+)?/adpub/sdk/adConfig(?:\\?.*)?$ - reject"
    - "(?i)^https?://(?:api\\.chelaile\\.net\\.cn|cdn\\.api\\.chelaileapp\\.cn)(?::\\d+)?/adpub/h5/detail_more/get(?:\\?.*)?$ - reject"
  script:
    - match: "(?i)^https://(?:get\\.shouji\\.sogou\\.com|sec\\.sginput\\.qq\\.com|worldwide\\.sogou\\.com)(?::443)?/q(?:\\?|$)"
      name: "Skyliner-AIO"
      type: request
      require-body: false
      timeout: 5
    - match: "(?i)^https?://swc\\.pinyin\\.sogou\\.com(?::(?:80|443))?/swc(?:\\.php|/0)(?:\\?|$)"
      name: "Skyliner-AIO"
      type: request
      require-body: false
      timeout: 5
script-providers:
  "Skyliner-AIO":
    payload: |
      const rules = [{"method":"POST","url":"^https://(?:get\\.shouji\\.sogou\\.com|sec\\.sginput\\.qq\\.com|worldwide\\.sogou\\.com)(?::443)?/q(?:\\?|$)","flags":"i","mime":"^\\s*application/(?:octet-stream|proto)\\s*(?:;.*)?$","mime_flags":"i"},{"method":"POST","url":"^https?://swc\\.pinyin\\.sogou\\.com(?::(?:80|443))?/swc(?:\\.php|/0)(?:\\?|$)","flags":"i"}];
      const headers = $request.headers || {};
      const keys = Object.keys(headers);
      const blocked = rules.some(function(rule) {
        if ($request.method !== rule.method || !new RegExp(rule.url, rule.flags).test($request.url)) return false;
        if (!rule.mime) return true;
        if (keys.some(function(key) { return key.toLowerCase() === "s-cookie"; })) return false;
        const key = keys.find(function(key) { return key.toLowerCase() === "content-type"; });
        return key !== undefined && new RegExp(rule.mime, rule.mime_flags).test(headers[key]);
      });
      $done(blocked ? {response:{status:503,headers:{"Content-Length":"0"},body:""}} : {});
